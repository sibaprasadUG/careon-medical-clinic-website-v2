# ============================================================
# CAREON MEDICAL CLINIC — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# GEMINI_API_KEY: Required for Gemini AI API features (server-side only)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host application URL (injected automatically in container)
APP_URL="MY_APP_URL"

# ============================================================
# PRODUCTION SUPABASE POSTGRESQL CONFIGURATION
# Project Name: careon-medical-clinic
# Required for: AI Studio Preview & Netlify Production Database
# Source: Supabase Dashboard -> Project Settings -> API
# ============================================================
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================================
# ADMINISTRATIVE AUTHENTICATION (Protected Server-side only)
# Required environment variables for admin access.
# Never expose these credentials to client-side code.
# ============================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Serverless Session HMAC Signing Secret (server-side only)
SESSION_SECRET=
